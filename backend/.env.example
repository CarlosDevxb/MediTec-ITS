# ================= Servidor =================
PORT=3000
# Orígenes permitidos por CORS (separados por coma).
# En producción agrega el dominio público del front:
#   CORS_ORIGEN=https://meditec.mx,http://localhost:4321
CORS_ORIGEN=http://localhost:4321

# ================= MySQL =================
DB_HOST=localhost
DB_PORT=3307
DB_USER=meditec_user
DB_PASSWORD=meditecpassword
DB_NAME=meditec_its

# ================= Seguridad =================
# Secreto para firmar los JWT. Genera uno fuerte con:
#   openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Vigencia del token (ej. 15m, 8h, 7d)
JWT_EXPIRACION=8h
# Rondas de hashing de contraseñas (bcrypt)
BCRYPT_RONDAS=10
