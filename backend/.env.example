# ============================================================
# Plantilla de configuración de la API (backend/.env)
# Copia este archivo a backend/.env y completa los valores.
#   cp backend/.env.example backend/.env
# Los secretos nunca se versionan (backend/.env está en .gitignore).
# ============================================================

# Puerto de la API (en Docker, el servicio se llama "backend")
PORT=3000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGEN=http://localhost:8080,http://localhost:4321

# Base de datos (en Docker Compose: host "db" y puerto 3306;
# el compose los sobrescribe automáticamente)
DB_HOST=localhost
DB_PORT=3307
DB_USER=meditec_user
DB_PASSWORD=meditecpassword
DB_NAME=meditec_its

# JWT: cambia este valor por uno propio, único y aleatorio
JWT_SECRET=cambia-este-secreto-por-uno-unico-y-aleatorio
JWT_EXPIRACION=8h

# Costo de bcrypt (10 es un buen equilibrio para desarrollo)
BCRYPT_RONDAS=10
