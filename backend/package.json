{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:linux": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile=meditec-api",
    "build:windows": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile=meditec-api.exe",
    "start": "tsx src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "crear:admin": "tsx src/utils/crearAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
