---
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>MediTec-ITSAB</title>
    <script>
      // Punto de entrada de la aplicación: si hay sesión iniciada
      // entra al panel que corresponde al rol; si no, va al login.
      import { obtenerSesion, rutaSegunRol } from '../services/sesion';

      const sesion = obtenerSesion();
      window.location.replace(
        sesion ? rutaSegunRol(sesion.usuario.rol, sesion.usuario.especialidad) : '/login',
      );
    </script>
  </head>
  <body class="m-0 p-0">
    <div class="min-h-screen flex items-center justify-center bg-brand-50 font-sans">
      <p class="text-gray-500 text-base">Redirigiendo a MediTec-ITS…</p>
    </div>
  </body>
</html>
